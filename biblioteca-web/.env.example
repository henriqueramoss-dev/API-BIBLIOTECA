# Endereço da API Spring Boot
VITE_API_URL=https://api-biblioteca-xgsa.onrender.com

# Capas de livros de verdade (Open Library, buscadas pelo ISBN). Use false para desligar.
VITE_CAPAS_REAIS=true

# Chave de API enviada no cabeçalho X-API-Key. Sem ela, o site só consegue consultar o catálogo
# (livros, autores e categorias). Use uma chave de nível ADMIN para cadastrar, alterar e excluir:
# a chave de administrador aparece no log da API ao iniciar (ou defina BIBLIOTECA_CHAVE_ADMIN).
# ATENÇÃO: tudo que começa com VITE_ fica visível no navegador. Use só no seu computador.
VITE_API_KEY=
