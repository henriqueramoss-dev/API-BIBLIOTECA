# Endereço da API Spring Boot
VITE_API_URL=https://api-biblioteca-xgsa.onrender.com

# Capas de livros de verdade (Open Library, buscadas pelo ISBN). Use false para desligar.
VITE_CAPAS_REAIS=true

# Chave de API do catálogo, enviada no cabeçalho X-API-Key aos visitantes (quem não entrou). Já vem no código
# (a chave de leitura do catálogo, que só lê livros, autores e categorias); só preencha para usar outra.
# ATENÇÃO: tudo que começa com VITE_ fica visível no navegador. Nunca use aqui uma chave de funcionário.
# VITE_API_KEY=
